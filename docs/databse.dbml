// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum user_role {
  PARENT
  ADMIN
}

Enum user_status {
  ACTIVE
  BLOCKED
}

Enum fundraiser_status {
  DRAFT  [note: 'Created, not visible to parents yet, no payments']
  ACTIVE [note: 'Open for payments']
  CLOSED [note: 'Closed by the treasurer, remaining money refunded']
}

Enum membership_status {
  PENDING  [note: 'Joined with an access code, waiting for treasurer approval']
  ACTIVE
  REJECTED [note: 'Request rejected by the treasurer']
  LEFT     [note: 'Removed by the treasurer or withdrawn by the parent']
}

Enum account_type {
  USER       [note: 'Parent wallet']
  FUNDRAISER [note: 'Account of one fundraiser']
}

Enum transaction_type {
  TOP_UP               [note: 'external -> user wallet (virtual top-up)']
  EXTERNAL_TRANSFER    [note: 'user wallet -> external bank account; the only way money leaves the system']
  FUNDRAISER_PAYMENT   [note: 'user wallet -> fundraiser, payment for a child']
  PAYMENT_REFUND       [note: 'fundraiser -> payer wallet, parent withdraws own payment while open']
  TREASURER_WITHDRAWAL [note: 'fundraiser -> treasurer wallet']
  TREASURER_DEPOSIT    [note: 'treasurer wallet -> fundraiser, money put back']
  CLOSE_REFUND         [note: 'fundraiser -> payer wallet, automatic refund on close']
}

Enum treasurer_operation_direction {
  WITHDRAWAL [note: 'fundraiser -> treasurer wallet']
  DEPOSIT    [note: 'treasurer wallet -> fundraiser']
}

// ---------------------------------------------------------------------------
// Users, children, classes
// ---------------------------------------------------------------------------

Table users {
  id uuid [pk]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  avatar_url varchar(500)
  role user_role [not null, default: 'PARENT']
  status user_status [not null, default: 'ACTIVE', note: 'BLOCKED users cannot log in or move money']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table children {
  id uuid [pk]
  parent_id uuid [not null, ref: > users.id, note: 'One parent per child (decided on purpose)']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  birth_date date
  avatar_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table classes {
  id uuid [pk]
  name varchar(100) [not null, note: 'e.g. "3B"']
  school_name varchar(255)
  treasurer_id uuid [not null, ref: > users.id, note: 'The parent who created the class']
  created_at timestamptz [not null, default: `now()`]
}

Table class_access_codes {
  id uuid [pk]
  class_id uuid [not null, ref: > classes.id]
  code varchar(100) [unique, not null]
  valid_until timestamptz [note: 'NULL = no expiry']
  active boolean [not null, default: true, note: 'Set to false when the treasurer generates a new code']
  created_at timestamptz [not null, default: `now()`]
}

Table child_class_memberships {
  id uuid [pk]
  child_id uuid [not null, ref: > children.id]
  class_id uuid [not null, ref: > classes.id]
  status membership_status [not null, default: 'PENDING']
  requested_at timestamptz [not null, default: `now()`]
  joined_at timestamptz [note: 'Set when the treasurer approves']
  left_at timestamptz

  indexes {
    (child_id, class_id) [unique, note: 'Re-joining after LEFT updates this row instead of adding a new one']
  }
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

Table accounts {
  id uuid [pk]
  iban varchar(34) [unique, not null, note: 'Fake, generated by the system']
  account_type account_type [not null]

  user_id uuid [unique, ref: - users.id, note: 'Set only for USER accounts; one wallet per user']
  fundraiser_id uuid [unique, ref: - fundraisers.id, note: 'Set only for FUNDRAISER accounts']

  balance decimal(12,2) [not null, default: 0, note: 'Always equals the sum of its transactions']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `balance >= 0` [name: 'account_balance_not_negative']
    `(account_type = 'USER' AND user_id IS NOT NULL AND fundraiser_id IS NULL) OR (account_type = 'FUNDRAISER' AND fundraiser_id IS NOT NULL AND user_id IS NULL)` [name: 'account_owner_matches_type']
  }
}

Table transactions {
  id uuid [pk]

  from_account_id uuid [ref: > accounts.id, note: 'NULL for TOP_UP (money comes from outside)']
  to_account_id uuid [ref: > accounts.id, note: 'NULL for EXTERNAL_TRANSFER (money leaves the system)']

  type transaction_type [not null]
  amount decimal(12,2) [not null]

  created_by uuid [not null, ref: > users.id, note: 'Who triggered it; for CLOSE_REFUND the treasurer']
  created_at timestamptz [not null, default: `now()`]

  description varchar(500)

  Note: 'Append-only: rows are never updated or deleted. Mistakes are fixed with a new transaction.'

  checks {
    `amount > 0` [name: 'transaction_amount_positive']
    `from_account_id IS NOT NULL OR to_account_id IS NOT NULL` [name: 'transaction_has_account']
  }
}

Table external_bank_accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]

  iban varchar(34) [not null, note: 'Configurable target of external transfers']
  account_name varchar(255)

  created_at timestamptz [not null, default: `now()`]
}

Table external_transfers {
  id uuid [pk]

  transaction_id uuid [unique, not null, ref: - transactions.id, note: 'A transaction of type EXTERNAL_TRANSFER']
  external_account_id uuid [not null, ref: > external_bank_accounts.id]

  created_at timestamptz [not null, default: `now()`]

  Note: 'Outgoing only. Top-ups are plain TOP_UP transactions without an external account.'
}

// ---------------------------------------------------------------------------
// Fundraisers
// ---------------------------------------------------------------------------

Table fundraisers {
  id uuid [pk]
  class_id uuid [not null, ref: > classes.id]
  author_id uuid [not null, ref: > users.id, note: 'Treasurer who created it']

  name varchar(255) [not null, note: 'The goal, e.g. "Theatre trip"']
  description text
  logo_url varchar(500)

  amount_per_child decimal(12,2) [not null, note: 'Payments are "binary": every child owes this amount']

  start_date date [not null]
  end_date date [not null]

  status fundraiser_status [not null, default: 'DRAFT']
  is_blocked boolean [not null, default: false, note: 'Set by the admin; independent of status, so unblocking restores the previous state']

  created_at timestamptz [not null, default: `now()`]
  closed_at timestamptz

  checks {
    `amount_per_child > 0` [name: 'fundraiser_amount_positive']
    `end_date >= start_date` [name: 'fundraiser_dates_valid']
  }
}

Table fundraiser_obligations {
  id uuid [pk]

  fundraiser_id uuid [not null, ref: > fundraisers.id]
  child_id uuid [not null, ref: > children.id]

  required_amount decimal(12,2) [not null, note: 'Copy of amount_per_child at the moment the row was created']

  created_at timestamptz [not null, default: `now()`]

  Note: 'Which children have to pay. To decide: created for ACTIVE members when the fundraiser starts? What about children who join later?'

  indexes {
    (fundraiser_id, child_id) [unique]
  }
}

Table fundraiser_payments {
  id uuid [pk]

  fundraiser_id uuid [not null, ref: > fundraisers.id]
  child_id uuid [not null, ref: > children.id]

  payer_id uuid [not null, ref: > users.id, note: 'May be a parent of a different child']
  transaction_id uuid [unique, not null, ref: - transactions.id, note: 'The FUNDRAISER_PAYMENT transaction']

  amount decimal(12,2) [not null]
  paid_at timestamptz [not null, default: `now()`]

  refunded_at timestamptz [note: 'Set when the payment is withdrawn or refunded on close']
  refund_transaction_id uuid [unique, ref: - transactions.id, note: 'The PAYMENT_REFUND or CLOSE_REFUND transaction; refunds go to payer_id']

  Note: 'A child counts as paid when the sum of its non-refunded payments reaches required_amount.'
}

Table treasurer_operations {
  id uuid [pk]

  fundraiser_id uuid [not null, ref: > fundraisers.id]
  author_id uuid [not null, ref: > users.id, note: 'The treasurer']
  transaction_id uuid [unique, not null, ref: - transactions.id, note: 'TREASURER_WITHDRAWAL or TREASURER_DEPOSIT']

  direction treasurer_operation_direction [not null]
  amount decimal(12,2) [not null]
  description varchar(500) [note: 'e.g. "Advance for theatre tickets"; visible to all parents']
  created_at timestamptz [not null, default: `now()`]
}

Table invoices {
  id uuid [pk]

  fundraiser_id uuid [not null, ref: > fundraisers.id]
  added_by uuid [not null, ref: > users.id]

  title varchar(255) [not null]
  amount decimal(12,2) [note: 'Informational only, does not move money']
  file_url varchar(500) [not null]

  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

Table chats {
  id uuid [pk]
  class_id uuid [ref: > classes.id, note: 'Set for a class chat; NULL for direct parent–parent and admin–treasurer chats']
  created_at timestamptz [not null, default: `now()`]
}

Table chat_participants {
  chat_id uuid [not null, ref: > chats.id]
  user_id uuid [not null, ref: > users.id]
  last_read_at timestamptz [note: 'Messages newer than this are unread for this user']

  indexes {
    (chat_id, user_id) [pk]
  }
}

Table messages {
  id uuid [pk]

  chat_id uuid [not null, ref: > chats.id]
  sender_id uuid [not null, ref: > users.id]

  content text [not null]
  created_at timestamptz [not null, default: `now()`]
}
